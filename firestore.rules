rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Roles ----------
    // El rol de cada cuenta vive en usuarios/{uid}. Solo un admin puede cambiarlo. El primer admin es el correo
    // semilla (verificado): así no hay que crear nada a mano. Cambia el correo aquí y en la función de Netlify.
    function esAdminSemilla() {
      return request.auth != null
        && request.auth.token.get('email', '') == 'santiagoromerov2008@gmail.com'
        && request.auth.token.get('email_verified', false) == true;
    }
    function tieneRol(roles) {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in roles;
    }
    function esAdmin() { return esAdminSemilla() || tieneRol(['admin']); }
    function esProfe() { return esAdminSemilla() || tieneRol(['profesor', 'admin']); }
    // Campos permitidos en usuarios/{uid}, con tipo y tamaño máximo (así nadie guarda basura ni textos gigantes)
    function usuarioValido(d) {
      return d.keys().hasOnly(['rol', 'email', 'nombre', 'creado', 'terminosVersion', 'terminosAceptados'])
        && d.rol in ['estudiante', 'profesor', 'admin']
        && d.get('email', '') is string && d.get('email', '').size() <= 254
        && d.get('nombre', '') is string && d.get('nombre', '').size() <= 120
        && d.get('terminosVersion', '') is string && d.get('terminosVersion', '').size() <= 32;
    }
    // Aceptación de los términos (terminosVersion + terminosAceptados): la escribe solo la propia persona y
    // siempre con la hora real del servidor. Nadie más (ni un admin) puede marcarla o cambiarla por otra cuenta.
    function terminosIntactos() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['terminosVersion', 'terminosAceptados']);
    }
    function aceptaTerminos() {
      return request.resource.data.get('terminosVersion', '').size() > 0
        && request.resource.data.get('terminosAceptados', null) == request.time;
    }

    // Resumen de la racha que publica cada estudiante (ver src/app/16-rachas-docente.js). Solo campos conocidos,
    // con tipo y tamaño máximo; el correo tiene que ser el de la sesión (nadie publica a nombre de otra persona).
    function rachaValida(d) {
      return d.keys().hasOnly(['nombre', 'email', 'dias', 'mejor', 'totalDias', 'xp', 'nivel', 'actualizado'])
        && d.nombre is string && d.nombre.size() <= 120
        && d.email is string && d.email == request.auth.token.get('email', '')
        && d.dias is list && d.dias.size() <= 400
        && d.mejor is int && d.mejor >= 0 && d.mejor <= 100000
        && d.totalDias is int && d.totalDias >= 0 && d.totalDias <= 100000
        && d.xp is int && d.xp >= 0
        && d.nivel is int && d.nivel >= 1 && d.nivel <= 100000
        && d.actualizado == request.time;
    }

    // Racha de cada estudiante: la escribe solo el propio estudiante; la leen él y los admin (los admin pueden listarlas todas).
    // Los profesores NO leen aquí: leen la copia que el estudiante deja en cada materia suya (temarios/{id}/rachas/{uid}).
    match /rachas/{u} {
      allow get: if request.auth != null && ( request.auth.uid == u || esAdmin() );
      allow list: if esAdmin();
      allow create, update: if request.auth != null && request.auth.uid == u && rachaValida(request.resource.data);
      allow delete: if request.auth != null && ( request.auth.uid == u || esAdmin() );
    }

    match /usuarios/{u} {
      allow get: if request.auth != null && (request.auth.uid == u || esAdmin());
      allow list: if esAdmin();
      // Cada cuenta nace como estudiante. Solo el correo semilla puede nacer como admin.
      allow create: if request.auth != null && request.auth.uid == u
        && usuarioValido(request.resource.data)
        && ( !('terminosVersion' in request.resource.data || 'terminosAceptados' in request.resource.data) || aceptaTerminos() )
        && ( request.resource.data.rol == 'estudiante'
             || ( request.resource.data.rol == 'admin' && esAdminSemilla() ) );
      // Nadie cambia su propio rol; un admin sí puede cambiar el de cualquiera (pero no su aceptación de los términos)
      allow update: if request.auth != null && usuarioValido(request.resource.data) && (
        ( esAdmin() && terminosIntactos() )
        || ( request.auth.uid == u
             && request.resource.data.rol == resource.data.rol
             && ( terminosIntactos() || aceptaTerminos() ) ) );
      allow delete: if request.auth != null && ( request.auth.uid == u || esAdmin() );
    }

    // Mis apuntes: privados. Solo su dueño los lee o escribe (ni el profesor ni un admin)
    match /anotaciones/{u}/items/{temaId} {
      allow read, delete: if request.auth != null && request.auth.uid == u;
      allow create, update: if request.auth != null && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['materiaId', 'texto', 'actualizado', 'titulo'])
        && ( !('titulo' in request.resource.data) || ( request.resource.data.titulo is string && request.resource.data.titulo.size() <= 120 ) )
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 20000
        && request.resource.data.materiaId is string
        && request.resource.data.actualizado is number;
    }

    // Datos personales: solo la propia persona
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Cada materia del cuaderno en su propio documento (así no se pisan entre equipos ni chocan con el límite de 1 MB)
      match /materias/{materiaId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
          && request.resource.data.data is string;
      }
    }

    // Materias compartidas entre compañeros (tipo 'compartida') y materias de docente (tipo 'docente')
    match /temarios/{id} {

      function esMiembro() {
        return request.auth.uid in resource.data.members;
      }
      function soloCambia(campos) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
      }
      function seAgregaA() {
        return request.resource.data.members == resource.data.members.concat([request.auth.uid])
          && soloMiNombre();
      }
      // Al unirse o salirse, solo se puede tocar el nombre propio en memberNames (no el de los demás)
      function soloMiNombre() {
        return request.resource.data.get('memberNames', {}).diff(resource.data.get('memberNames', {})).affectedKeys().hasOnly([request.auth.uid])
          && ( !(request.auth.uid in request.resource.data.get('memberNames', {}))
               || ( request.resource.data.memberNames[request.auth.uid] is string
                    && request.resource.data.memberNames[request.auth.uid].size() <= 120 ) );
      }

      // Solo los miembros leen
      allow read: if request.auth != null && esMiembro();

      // Crear: quien crea queda como dueño y único miembro
      allow create: if request.auth != null
        && esProfe()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.get('tipo', 'compartida') in ['compartida', 'docente'];

      allow update: if request.auth != null && (
        // Unirse con código: solo materias entre compañeros, y solo agregándose a sí misma
        ( !esMiembro()
          && resource.data.get('tipo', 'compartida') == 'compartida'
          && soloCambia(['members', 'memberNames'])
          && seAgregaA() )
        ||
        // Unirse por invitación del docente: el correo verificado (en minúsculas) debe tener una invitación
        ( !esMiembro()
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/invitaciones/$(id + '_' + request.auth.token.email.lower()))
          && get(/databases/$(database)/documents/invitaciones/$(id + '_' + request.auth.token.email.lower())).data.get('estado', 'pendiente') != 'rechazada'
          && soloCambia(['members', 'memberNames'])
          && seAgregaA() )
        ||
        // Unirse con el código de clase del docente: el código tiene que estar activo en la materia y la persona
        // tiene que haber registrado su uso en codigosClase/{código}/usos/{uid}, cosa que solo puede hacer quien conoce
        // el código actual (si el docente lo cambia o lo desactiva, el código viejo deja de servir).
        ( !esMiembro()
          && resource.data.get('tipo', 'compartida') == 'docente'
          && resource.data.get('codigo', '') is string
          && resource.data.get('codigo', '') != ''
          && get(/databases/$(database)/documents/codigosClase/$(resource.data.codigo)).data.sid == id
          && existsAfter(/databases/$(database)/documents/codigosClase/$(resource.data.codigo)/usos/$(request.auth.uid))
          && soloCambia(['members', 'memberNames'])
          && seAgregaA() )
        ||
        // Salirse: un miembro (que no sea el dueño) solo puede quitarse a sí mismo
        ( esMiembro()
          && request.auth.uid != resource.data.ownerUid
          && soloCambia(['members', 'memberNames'])
          && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
          && soloMiNombre() )
        ||
        // El dueño (docente o creador del grupo) puede editar, menos cambiar de dueño
        ( resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.get('tipo', 'compartida') in ['compartida', 'docente'] )
      );

      // Solo el dueño elimina la materia
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      // Temas y tarjetas
      match /temas/{temaId} {
        function padre() {
          return get(/databases/$(database)/documents/temarios/$(id)).data;
        }
        function esDocente() {
          return padre().get('tipo', 'compartida') == 'docente';
        }

        // Materia de docente: el estudiante solo lee lo publicado. Compañeros: todos leen.
        allow read: if request.auth != null
          && request.auth.uid in padre().members
          && ( !esDocente()
               || padre().ownerUid == request.auth.uid
               || resource.data.publicado == true );

        // Materia de docente: solo el docente escribe. Compañeros: todos escriben.
        allow write: if request.auth != null
          && request.auth.uid in padre().members
          && ( !esDocente() || padre().ownerUid == request.auth.uid );

        // Documento original que subió el docente (PDF/PPTX), troceado en base64: temas/{temaId}/archivo/{n}
        // Lo lee quien puede leer el tema (el estudiante solo si el tema está publicado). Lo escribe quien puede escribir el tema.
        // Imágenes de un tema (JPEG/PNG/WebP ya comprimidas, en base64): las lee quien puede leer el tema; solo escribe el profesor dueño
        match /medios/{mid} {
          allow read: if request.auth != null
            && request.auth.uid in padre().members
            && ( !esDocente()
                 || padre().ownerUid == request.auth.uid
                 || get(/databases/$(database)/documents/temarios/$(id)/temas/$(temaId)).data.publicado == true );
          allow create, update: if request.auth != null
            && esProfe()
            && request.auth.uid in padre().members
            && ( !esDocente() || padre().ownerUid == request.auth.uid )
            && request.resource.data.keys().hasOnly(['data', 'tipo', 'nombre'])
            && request.resource.data.tipo == 'img'
            && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 120
            && request.resource.data.data is string
            && request.resource.data.data.size() <= 750000
            && request.resource.data.data.matches('data:image/(jpeg|png|webp);base64,.*');
          allow delete: if request.auth != null
            && request.auth.uid in padre().members
            && ( !esDocente() || padre().ownerUid == request.auth.uid );
        }

        match /archivo/{parte} {
          allow read: if request.auth != null
            && request.auth.uid in padre().members
            && ( !esDocente()
                 || padre().ownerUid == request.auth.uid
                 || get(/databases/$(database)/documents/temarios/$(id)/temas/$(temaId)).data.publicado == true );
          allow create, update: if request.auth != null
            && esProfe()
            && request.auth.uid in padre().members
            && ( !esDocente() || padre().ownerUid == request.auth.uid )
            && request.resource.data.keys().hasOnly(['i', 'data'])
            && request.resource.data.i is int
            && request.resource.data.data is string
            && request.resource.data.data.size() <= 700000;
          allow delete: if request.auth != null
            && request.auth.uid in padre().members
            && ( !esDocente() || padre().ownerUid == request.auth.uid );
        }
      }

      // ---- Exámenes de una materia de docente ----
      function esDuenoMateria() {
        return get(/databases/$(database)/documents/temarios/$(id)).data.ownerUid == request.auth.uid;
      }
      function esMiembroMateria() {
        return request.auth.uid in get(/databases/$(database)/documents/temarios/$(id)).data.members;
      }

      // Las preguntas NO traen la respuesta correcta. Los estudiantes solo ven los publicados o cerrados.
      match /examenes/{exId} {
        allow read: if request.auth != null
          && ( esDuenoMateria()
               || ( esMiembroMateria() && resource.data.estado in ['publicado', 'cerrado'] ) );
        allow write: if request.auth != null && esDuenoMateria();
      }

      // ---- Calendario de la materia de docente ----
      // El docente (dueño) crea, edita y borra eventos; todos los miembros de la materia los leen.
      match /eventos/{evId} {
        function eventoValido() {
          let d = request.resource.data;
          return d.keys().hasOnly(['title', 'date', 'type', 'hora', 'nota', 'by', 'creado', 'actualizado'])
            && d.title is string && d.title.size() > 0 && d.title.size() <= 120
            && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.type in ['ex', 'en', 'ac', 'ot']
            && d.get('hora', '') is string && d.get('hora', '').matches('^([0-9]{2}:[0-9]{2})?$')
            && d.get('nota', '') is string && d.get('nota', '').size() <= 500
            && d.get('by', '') is string && d.get('by', '').size() <= 80;
        }
        allow read: if request.auth != null && esMiembroMateria();
        allow create, update: if request.auth != null && esDuenoMateria() && eventoValido();
        allow delete: if request.auth != null && esDuenoMateria();
      }

      // Comentario del docente sobre la entrega de un estudiante. Id: <examId>_<uid>. Solo el docente escribe; el estudiante lee el suyo.
      match /comentarios/{cId} {
        allow read: if request.auth != null
          && ( esDuenoMateria() || resource.data.uid == request.auth.uid );
        allow create, update: if request.auth != null && esDuenoMateria()
          && request.resource.data.keys().hasOnly(['examId', 'uid', 'texto', 'actualizado'])
          && cId == request.resource.data.examId + '_' + request.resource.data.uid
          && request.resource.data.texto is string && request.resource.data.texto.size() <= 1000;
        allow delete: if request.auth != null && esDuenoMateria();
      }

      // Racha de cada estudiante en esta materia: la escribe solo el propio estudiante, y solo si es miembro (no el dueño).
      // La lee el docente dueño de la materia (así ve y descarga las rachas de SU clase) y el propio estudiante.
      match /rachas/{u} {
        allow read: if request.auth != null && ( esDuenoMateria() || request.auth.uid == u );
        allow create, update: if request.auth != null && request.auth.uid == u
          && esMiembroMateria() && !esDuenoMateria()
          && rachaValida(request.resource.data);
        allow delete: if request.auth != null && ( request.auth.uid == u || esDuenoMateria() );
      }

      // Anuncios del docente para toda la materia: todos los miembros leen, solo el docente escribe.
      match /anuncios/{aId} {
        allow read: if request.auth != null && esMiembroMateria();
        allow create: if request.auth != null && esDuenoMateria()
          && request.resource.data.keys().hasOnly(['texto', 'by', 'creado'])
          && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 1000
          && request.resource.data.get('by', '') is string && request.resource.data.get('by', '').size() <= 80;
        allow update: if false;
        allow delete: if request.auth != null && esDuenoMateria();
      }

      // La clave (respuestas correctas): el docente siempre; el estudiante SOLO después de entregar.
      match /claves/{exId} {
        allow read: if request.auth != null
          && ( esDuenoMateria()
               || ( esMiembroMateria()
                    && exists(/databases/$(database)/documents/temarios/$(id)/intentos/$(exId + '_' + request.auth.uid)) ) );
        allow write: if request.auth != null && esDuenoMateria();
      }

      // Hora de inicio de cada estudiante en un examen con tiempo límite. Se crea una sola vez (la hora la pone el servidor)
      // y el estudiante no puede borrarla ni cambiarla; solo el docente (por ejemplo, para permitir repetir).
      match /inicios/{inId} {
        allow read: if request.auth != null
          && ( esDuenoMateria() || resource.data.uid == request.auth.uid );
        allow create: if request.auth != null
          && esMiembroMateria() && !esDuenoMateria()
          && request.resource.data.keys().hasOnly(['examId', 'uid', 'nombre', 'inicio'])
          && request.resource.data.uid == request.auth.uid
          && inId == request.resource.data.examId + '_' + request.auth.uid
          && request.resource.data.inicio == request.time
          && get(/databases/$(database)/documents/temarios/$(id)/examenes/$(request.resource.data.examId)).data.estado == 'publicado'
          && ( get(/databases/$(database)/documents/temarios/$(id)/examenes/$(request.resource.data.examId)).data.get('cierre', 0) == 0
               || request.time.toMillis() <= get(/databases/$(database)/documents/temarios/$(id)/examenes/$(request.resource.data.examId)).data.cierre );
        allow update, delete: if request.auth != null && esDuenoMateria();
      }

      // Entregas: una por estudiante y examen (el id lo fuerza). Se crean una vez y no se modifican,
      // así la nota la calcula el docente sobre respuestas que el estudiante no puede alterar.
      match /intentos/{inId} {
        allow read: if request.auth != null
          && ( esDuenoMateria() || resource.data.uid == request.auth.uid );
        allow create: if request.auth != null
          && esMiembroMateria() && !esDuenoMateria()
          && request.resource.data.keys().hasOnly(['examId', 'uid', 'nombre', 'email', 'respuestas', 'enviado'])
          && request.resource.data.uid == request.auth.uid
          && inId == request.resource.data.examId + '_' + request.auth.uid
          && request.resource.data.enviado == request.time
          && get(/databases/$(database)/documents/temarios/$(id)/examenes/$(request.resource.data.examId)).data.estado == 'publicado'
          && ( get(/databases/$(database)/documents/temarios/$(id)/examenes/$(request.resource.data.examId)).data.get('cierre', 0) == 0
               || request.time.toMillis() <= get(/databases/$(database)/documents/temarios/$(id)/examenes/$(request.resource.data.examId)).data.cierre )
          // Con tiempo límite: hace falta haber comenzado y entregar dentro del tiempo (con 60 s de margen por la red)
          && ( get(/databases/$(database)/documents/temarios/$(id)/examenes/$(request.resource.data.examId)).data.get('duracion', 0) == 0
               || ( exists(/databases/$(database)/documents/temarios/$(id)/inicios/$(request.resource.data.examId + '_' + request.auth.uid))
                    && request.time.toMillis() <= get(/databases/$(database)/documents/temarios/$(id)/inicios/$(request.resource.data.examId + '_' + request.auth.uid)).data.inicio.toMillis()
                         + get(/databases/$(database)/documents/temarios/$(id)/examenes/$(request.resource.data.examId)).data.duracion * 60000 + 60000 ) );
        allow update: if false;
        allow delete: if request.auth != null && esDuenoMateria();
      }
    }

    // Invitaciones de docente a un correo. El id es  <idMateria>_<correo en minúsculas>
    match /invitaciones/{inv} {

      // El docente ve las que envió; el estudiante ve las dirigidas a su correo (verificado)
      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid
        || ( request.auth.token.email_verified == true
             && resource.data.email == request.auth.token.email.lower() ) );

      // Solo el dueño de la materia puede invitar a esa materia
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/temarios/$(request.resource.data.sid)).data.ownerUid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email == request.resource.data.email.lower()
        && inv == request.resource.data.sid + '_' + request.resource.data.email;

      allow update: if request.auth != null && (
        // El docente puede reenviar o corregir su invitación
        ( resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.sid == resource.data.sid
          && request.resource.data.email == resource.data.email )
        ||
        // La persona invitada solo puede aceptar o rechazar
        ( request.auth.token.email_verified == true
          && resource.data.email == request.auth.token.email.lower()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'uid', 'nombre'])
          && request.resource.data.estado in ['aceptada', 'rechazada'] )
      );

      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Códigos de clase: codigosClase/{código} → { sid, ownerUid }. Cualquiera con sesión puede buscar UN código
    // (get), pero nadie puede listarlos. Solo el dueño de la materia crea o borra el código de su materia.
    match /codigosClase/{codigo} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && codigo.matches('^[A-Z0-9]{6,10}$')
        && request.resource.data.keys().hasOnly(['sid', 'ownerUid', 'creado'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.sid is string
        && get(/databases/$(database)/documents/temarios/$(request.resource.data.sid)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/temarios/$(request.resource.data.sid)).data.get('tipo', 'compartida') == 'docente';
      allow update: if false;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      // Constancia de que la persona escribió este código (la regla de unirse la exige). Solo la propia persona la crea.
      match /usos/{u} {
        allow get: if request.auth != null && request.auth.uid == u;
        allow list: if false;
        allow create, update: if request.auth != null && request.auth.uid == u
          && exists(/databases/$(database)/documents/codigosClase/$(codigo))
          && request.resource.data.keys().hasOnly(['creado']);
        allow delete: if false;
      }
    }

    // Banco de preguntas del docente: solo lo ve y lo edita él. Sirve para reutilizar preguntas entre exámenes y semestres.
    match /bancoPreguntas/{u}/items/{pid} {
      allow read, delete: if request.auth != null && request.auth.uid == u;
      allow create, update: if request.auth != null && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['enunciado', 'opciones', 'correcta', 'temaTitulo', 'corte', 'materia', 'creado'])
        && request.resource.data.enunciado is string && request.resource.data.enunciado.size() <= 1000
        && request.resource.data.opciones is list && request.resource.data.opciones.size() == 4
        && request.resource.data.correcta is int && request.resource.data.correcta >= 0 && request.resource.data.correcta < 4;
    }

    // Cupo diario de archivos para la IA (día en hora de Colombia, UTC-5). La función de Netlify lo lee y lo sube de 1 en 1
    // con el token de la propia persona; las reglas impiden bajarlo, borrarlo o reiniciarlo antes de medianoche.
    match /iaUso/{u} {
      function hoyCol() {
        return math.floor((request.time.toMillis() - 18000000) / 86400000);
      }
      allow read: if request.auth != null && request.auth.uid == u;
      allow create: if request.auth != null && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['dia', 'n'])
        && request.resource.data.dia == hoyCol()
        && request.resource.data.n == 1;
      allow update: if request.auth != null && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['dia', 'n'])
        && request.resource.data.dia == hoyCol()
        && ( ( resource.data.dia == hoyCol() && request.resource.data.n == resource.data.n + 1 )
             || ( resource.data.dia != hoyCol() && request.resource.data.n == 1 ) );
      allow delete: if false;
    }

    // Cupo diario del chat "Pregúntale a la IA" (cualquier rol). Mismas reglas que iaUso: solo sube de 1 en 1.
    match /iaChat/{u} {
      function hoyColChat() {
        return math.floor((request.time.toMillis() - 18000000) / 86400000);
      }
      allow read: if request.auth != null && request.auth.uid == u;
      allow create: if request.auth != null && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['dia', 'n'])
        && request.resource.data.dia == hoyColChat()
        && request.resource.data.n == 1;
      allow update: if request.auth != null && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['dia', 'n'])
        && request.resource.data.dia == hoyColChat()
        && ( ( resource.data.dia == hoyColChat() && request.resource.data.n == resource.data.n + 1 )
             || ( resource.data.dia != hoyColChat() && request.resource.data.n == 1 ) );
      allow delete: if false;
    }

    // Límite por hora de peticiones a la IA (hora = milisegundos / 3 600 000). La función de Netlify lo lee y lo sube
    // de 1 en 1 con el token de la propia persona; las reglas impiden bajarlo o borrarlo dentro de la misma hora.
    match /iaHora/{u} {
      function horaAhora() {
        return math.floor(request.time.toMillis() / 3600000);
      }
      allow read: if request.auth != null && request.auth.uid == u;
      allow create: if request.auth != null && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['h', 'n'])
        && request.resource.data.h == horaAhora()
        && request.resource.data.n == 1;
      allow update: if request.auth != null && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['h', 'n'])
        && request.resource.data.h == horaAhora()
        && ( ( resource.data.h == horaAhora() && request.resource.data.n == resource.data.n + 1 )
             || ( resource.data.h != horaAhora() && request.resource.data.n == 1 ) );
      allow delete: if false;
    }

    // Trabajos de IA en segundo plano. La función de Netlify escribe aquí el resultado usando el
    // token de la propia persona, así que solo puede tocar sus propios trabajos.
    match /iaJobs/{job} {
      allow create: if request.auth != null && esProfe() && request.resource.data.uid == request.auth.uid   // solo profesores y admin usan la IA
        && request.resource.data.keys().hasOnly(['uid', 'estado', 'creado']);
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;

      // PDF escaneado, troceado en base64, que la función en segundo plano lee y borra al terminar.
      match /entrada/{n} {
        function trabajoMio() {
          return get(/databases/$(database)/documents/iaJobs/$(job)).data.uid == request.auth.uid;
        }
        allow create, update: if request.auth != null
          && esProfe()
          && trabajoMio()
          && ( resource == null || resource.data.uid == request.auth.uid )
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['i', 'uid', 'data'])
          && request.resource.data.i is int
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 700000;
        allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }
    }
  }
}
